# GitHub
GITHUB_TOKEN=
# Reserved for a future locally approved SIG repository scope.
# GITHUB_ORG=FDUCSLG
# LEADBOARD_GROUP_PROPERTY=leadboard_sig

# Database
DATABASE_URL=postgresql://leadboard:leadboard@localhost:5432/leadboard

# Backend
PORT=3000

# Optional during frontend development: show schema-validated demo data.
# Never enable mock mode for a production build.
# VITE_LEADBOARD_API_MODE=mock

# Ingestion
# Default: every 6 hours
INGESTION_CRON_SCHEDULE=0 */6 * * *

# First sync collects enough history to cover the 90-day dashboard filter
INITIAL_SYNC_DAYS=90

# Incremental sync overlaps the previous successful range by N minutes.
# Idempotent upsert removes duplicates and avoids boundary misses.
SYNC_OVERLAP_MINUTES=10

# Freshness threshold
DATA_STALE_AFTER_HOURS=12
